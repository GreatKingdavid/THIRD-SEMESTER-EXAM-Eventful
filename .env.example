# App
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://eventful_user:eventful_pass@localhost:5432/eventful_db?schema=public"

# Redis (cache layer)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Paystack
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_BASE_URL="https://api.paystack.co"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
